# Copy to .env (gitignored) and fill in. Keys are read via python-dotenv.

# Fixed user simulator (required for any ablation or RL run).
# Official DeepSeek API; the project uses deepseek-v4-pro in non-thinking mode.
DEEPSEEK_API_KEY=

# Simulator-sensitivity fallback (dev only): dated DashScope Qwen snapshot.
DASHSCOPE_API_KEY=

# RL training evidence (GPU box only).
WANDB_API_KEY=

# China network: uncomment to pull models through the HF mirror.
# HF_ENDPOINT=https://hf-mirror.com
